-- Minimize Button Toggle Logic
minBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		minBtn.Text = "+"
		tabFrame.Visible = false
		searchBox.Visible = false
		searchBtn.Visible = false
		statusLabel.Visible = false
		listFrame.Visible = false
		tween(frame, { Size = UDim2.new(OPEN_SIZE.X.Scale, OPEN_SIZE.X.Offset, 0, MIN_SIZE_Y) })
	else
		minBtn.Text = "-"
		tabFrame.Visible = true
		searchBox.Visible = true
		searchBtn.Visible = true
		statusLabel.Visible = true
		listFrame.Visible = true
		tween(frame, { Size = OPEN_SIZE })
	end
end)

-- Global Keybind Input Handler
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe or listeningKeyForEmote then return end
	if input.UserInputType == Enum.UserInputType.Keyboard then
		local keyName = input.KeyCode.Name
		for strId, boundKey in pairs(userConfig.Keybinds) do
			if boundKey == keyName then
				local numId = tonumber(strId)
				local targetEmote = nil
				
				for _, e in ipairs(customEmotesList) do
					if e.id == numId then
						targetEmote = e
						break
					end
				end
				if not targetEmote then
					for _, d in ipairs(DEFAULTS) do
						if d.id == numId then
							targetEmote = d
							break
						end
					end
				end

				if targetEmote then
					task.spawn(function()
						playEmote(targetEmote)
					end)
					playingKey = targetEmote.id
				end
				break
			end
		end
	end
end)

listFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
	if listFrame.CanvasPosition.Y + listFrame.AbsoluteWindowSize.Y >= listFrame.AbsoluteCanvasSize.Y - 80 then
		loadMore()
	end
end)

searchBtn.MouseButton1Click:Connect(function() resetAndSearch(searchBox.Text) end)
searchBox.FocusLost:Connect(function(enter) if enter then resetAndSearch(searchBox.Text) end end)
closeBtn.MouseButton1Click:Connect(function() stopEmote() gui:Destroy() end)

loadMore()
