--------------------------------------------------------------------------------
-- UI HELPER FUNCTIONS
--------------------------------------------------------------------------------
local function tween(i, p, info)
	local t = TweenService:Create(i, info or TWEEN_INFO, p)
	t:Play()
	return t
end

local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = r or UDim.new(0, 12)
	c.Parent = p
end

local function stroke(p, col, th)
	local s = Instance.new("UIStroke")
	s.Color = col or THEME.Stroke
	s.Thickness = th or 1
	s.Parent = p
	return s
end

local function makeButton(parent, props)
	local btn = Instance.new("TextButton")
	btn.Size = props.Size or UDim2.new(1, 0, 0, 28)
	btn.BackgroundColor3 = props.BackgroundColor3 or THEME.ButtonIdle
	btn.BackgroundTransparency = props.BackgroundTransparency or 0.25
	btn.AutoButtonColor = false
	btn.Text = props.Text or ""
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = props.TextSize or 12
	btn.TextColor3 = props.TextColor3 or THEME.TextPrimary
	btn.Parent = parent
	corner(btn, UDim.new(0, 8))
	local st = stroke(btn)
	st.Transparency = 0.3
	btn.MouseEnter:Connect(function()
		tween(btn, { BackgroundColor3 = props.HoverColor or THEME.ButtonHover, BackgroundTransparency = 0.1 }, HOVER_TWEEN)
		tween(st, { Color = THEME.Accent, Transparency = 0 }, HOVER_TWEEN)
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, {
			BackgroundColor3 = props.BackgroundColor3 or THEME.ButtonIdle,
			BackgroundTransparency = props.BackgroundTransparency or 0.25
		}, HOVER_TWEEN)
		tween(st, { Color = THEME.Stroke, Transparency = 0.3 }, HOVER_TWEEN)
	end)
	return btn
end

local function httpGet(url)
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if req then
		local ok, res = pcall(function() return req({ Url = url, Method = "GET" }) end)
		if ok and res then
			local body = res.Body or res.body
			if type(body) == "string" and #body > 0 then return body end
		end
	end
	local ok2, body2 = pcall(function() return game:HttpGet(url) end)
	return ok2 and body2 or nil
end

--------------------------------------------------------------------------------
-- EMOTE PLAYBACK LOGIC
--------------------------------------------------------------------------------
local statusLabelRef = nil

local function stopEmote()
	currentTrack = nil
	playingKey = nil
	local char = LocalPlayer.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function() hum:UnequipTools() end)
		end
	end
	if statusLabelRef then statusLabelRef.Text = "Stopped" end
end

local function tryPlayTrack(animId)
	local char = LocalPlayer.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end

	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local animObj = Instance.new("Animation")
	animObj.AnimationId = "rbxassetid://" .. tostring(animId)

	local loadedTrack = nil
	local ok = pcall(function() loadedTrack = animator:LoadAnimation(animObj) end)
	if not ok or not loadedTrack then
		pcall(function() loadedTrack = hum:LoadAnimation(animObj) end)
	end

	if loadedTrack then
		loadedTrack.Priority = Enum.AnimationPriority.Action4
		loadedTrack.Looped = true
		local played = pcall(function() loadedTrack:Play(0.1, 1, 1) end)
		if played then
			task.wait(0.05)
			if loadedTrack.IsPlaying or loadedTrack.Length > 0 then
				return loadedTrack
			end
		end
		pcall(function() loadedTrack:Stop() loadedTrack:Destroy() end)
	end

	return nil
end

local function resolveAnimationIds(assetId)
	local strId = tostring(assetId)
	local cleaned = (strId:gsub("%D", ""))
	assetId = tonumber(cleaned)
	if not assetId then return {} end
	if animCache[assetId] then return animCache[assetId] end

	local candidates = {}
	local getObjects = rawget(getfenv(), "getobjects") or game.GetObjects
	if getObjects then
		pcall(function()
			local objs = getObjects("rbxassetid://" .. tostring(assetId))
			if type(objs) == "table" then
				for _, obj in ipairs(objs) do
					if obj:IsA("Animation") and obj.AnimationId ~= "" then
						local num = obj.AnimationId:match("%d+")
						if num then table.insert(candidates, tonumber(num)) end
					end
					for _, desc in ipairs(obj:GetDescendants()) do
						if desc:IsA("Animation") and desc.AnimationId ~= "" then
							local num = desc.AnimationId:match("%d+")
							if num then table.insert(candidates, tonumber(num)) end
						end
					end
					pcall(function() obj:Destroy() end)
				end
			end
		end)
	end

	if #candidates == 0 then
		pcall(function()
			local url = "https://assetdelivery.roblox.com/v1/asset/?id=" .. tostring(assetId)
			local body = httpGet(url)
			if body then
				for num in string.gmatch(body, "rbxassetid://(%d+)") do
					table.insert(candidates, tonumber(num))
				end
				for num in string.gmatch(body, "id=(%d+)") do
					table.insert(candidates, tonumber(num))
				end
			end
		end)
	end

	table.insert(candidates, assetId)

	local unique, hash = {}, {}
	for _, id in ipairs(candidates) do
		if id and not hash[id] then
			hash[id] = true
			table.insert(unique, id)
		end
	end

	animCache[assetId] = unique
	return unique
end

local function playEmote(emote)
	stopEmote()
	local char = LocalPlayer.Character
	if not char then return false, "No Character" end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return false, "No Humanoid" end

	local rawId = emote.animId or emote.id
	if not rawId then return false, "Invalid ID" end
	local emoteName = emote.name or "Emote"
	local numId = tonumber((tostring(rawId):gsub("%D", "")))

	if numId then
		local okDesc = pcall(function()
			local desc = hum:FindFirstChildOfClass("HumanoidDescription") or hum:GetAppliedDescription()
			if desc then
				local currentEmotes = desc:GetEmotes()
				currentEmotes[emoteName] = { numId }
				desc:SetEmotes(currentEmotes)
				return hum:PlayEmote(emoteName)
			end
		end)
		if okDesc then return true end
	end

	if emoteName then
		local okBuiltin = pcall(function() return hum:PlayEmote(emoteName) end)
		if okBuiltin then return true end
		
		if numId then
			local okBuiltinId = pcall(function() return hum:PlayEmote(emoteName, numId) end)
			if okBuiltinId then return true end
		end
	end

	local animateScript = char:FindFirstChild("Animate")
	if animateScript then
		local playEmoteEvent = animateScript:FindFirstChild("PlayEmote")
		if playEmoteEvent and playEmoteEvent:IsA("BindableEvent") then
			local okEvent = pcall(function()
				playEmoteEvent:Fire(emoteName, numId or rawId)
			end)
			if okEvent then
				task.wait(0.1)
				if hum:GetState() == Enum.HumanoidStateType.PerformingEmote then
					return true
				end
			end
		end
	end

	local resolvedIds = resolveAnimationIds(rawId)
	for _, animId in ipairs(resolvedIds) do
		local track = tryPlayTrack(animId)
		if track then
			currentTrack = track
			return true
		end
	end

	return false, "Emote restricted by game permissions"
end

