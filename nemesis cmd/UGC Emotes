local function parseEmoteJSON(body)
	local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
	if not ok or type(data) ~= "table" then return {} end

	local list = {}
	local targetContainer = data.emotes or data.data or data.Emotes or data

	for k, v in pairs(targetContainer) do
		if type(v) == "table" then
			local rawId = v.id or v.assetId or v.animId or v.AnimationId or v.EmoteId or v.asset_id
			local cleanIdStr = rawId and (tostring(rawId):gsub("%D", "")) or nil
			local id = cleanIdStr and tonumber(cleanIdStr)
			local name = v.name or v.Name or v.title or v.title_name or tostring(k)
			local rawAnimId = v.animId or v.animationId or v.AnimId or id
			local cleanAnimStr = rawAnimId and (tostring(rawAnimId):gsub("%D", "")) or nil
			local animId = cleanAnimStr and tonumber(cleanAnimStr) or id

			if id then
				table.insert(list, { id = id, name = tostring(name), animId = animId })
			end
		elseif type(v) == "number" or type(v) == "string" then
			local cleanStr = (tostring(v):gsub("%D", ""))
			local num = tonumber(cleanStr)
			if num then table.insert(list, { id = num, name = tostring(k), animId = num }) end
		end
	end
	return list
end

