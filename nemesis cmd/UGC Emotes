	playBtn.Position = UDim2.new(1, -52, 0.5, -12)

	rowButtons[emote.id] = { Row = row, Key = keyBtn, Fav = favBtn, Emote = emote }

	favBtn.MouseButton1Click:Connect(function()
		local newState = not (userConfig.Favourites[strId] == true)
		if newState then
			userConfig.Favourites[strId] = true
			favBtn.Text = "★"
			favBtn.TextColor3 = THEME.Yellow
		else
			userConfig.Favourites[strId] = nil
			favBtn.Text = "☆"
			favBtn.TextColor3 = THEME.TextMuted
			if activePage == "Favourites" then
				row:Destroy()
				rowButtons[emote.id] = nil
			end
		end
		saveUserConfig()
	end)

	local function startKeyListening()
		listeningKeyForEmote = emote
		keyBtn.Text = "..."
		statusLabel.Text = "Press any key to bind (or click off / ESC to set None)"

		local inputConn
		local focusConn

		local function cleanup()
			if inputConn then inputConn:Disconnect() end
			if focusConn then focusConn:Disconnect() end
			listeningKeyForEmote = nil
		end

		inputConn = UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local k = input.KeyCode
				if k == Enum.KeyCode.Escape or k == Enum.KeyCode.Backspace then
					userConfig.Keybinds[strId] = nil
					keyBtn.Text = "None"
					statusLabel.Text = "Key cleared for " .. emote.name
				else
					userConfig.Keybinds[strId] = k.Name
					keyBtn.Text = k.Name
					statusLabel.Text = "Bound " .. emote.name .. " to [" .. k.Name .. "]"
				end
				saveUserConfig()
				cleanup()
			end
		end)

		focusConn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				task.wait(0.05)
				if listeningKeyForEmote == emote then
					userConfig.Keybinds[strId] = nil
					keyBtn.Text = "None"
					statusLabel.Text = "Key set to None for " .. emote.name
					saveUserConfig()
					cleanup()
				end
			end
		end)
	end

	keyBtn.MouseButton1Click:Connect(function()
		startKeyListening()
	end)

	playBtn.MouseButton1Click:Connect(function()
		statusLabel.Text = "Playing " .. emote.name .. "..."
		playBtn.Text = "..."

		task.spawn(function()
			local success, ok = pcall(function()
				return playEmote(emote)
			end)
			playBtn.Text = "Play"
			if success and ok == true then
				playingKey = emote.id
				statusLabel.Text = "Playing: " .. emote.name
			else
				statusLabel.Text = "Failed to play emote"
			end
		end)
	end)
end

local function updateFilteredList()
	currentFiltered = {}
	local filterKw = string.lower(currentKeyword)
	for _, e in ipairs(customEmotesList) do
		local strId = tostring(e.id)
		local passesSearch = (filterKw == "" or string.find(string.lower(e.name), filterKw, 1, true))
		
		local passesPage = true
		if activePage == "Favourites" then
			passesPage = (userConfig.Favourites[strId] == true)
		elseif activePage == "Keys" then
			passesPage = (userConfig.Keybinds[strId] ~= nil and userConfig.Keybinds[strId] ~= "None")
		end

		if passesSearch and passesPage then
			table.insert(currentFiltered, e)
		end
	end
end

local function loadMore()
	if isLoading or noMore then return end
	isLoading = true

	task.spawn(function()
		if not loadedCustom then
			statusLabel.Text = "Fetching Emotes catalog..."
			local body = httpGet(JSON_URL)
			if body then customEmotesList = parseEmoteJSON(body) end

			if #customEmotesList == 0 then
				statusLabel.Text = "JSON empty, using defaults"
				for _, d in ipairs(DEFAULTS) do table.insert(customEmotesList, d) end
			end

			loadedCustom = true
			updateFilteredList()
		end

		local endIndex = math.min(currentIndex + PAGE_SIZE - 1, #currentFiltered)
		if currentIndex <= #currentFiltered then
			for i = currentIndex, endIndex do
				local e = currentFiltered[i]
				if e and e.id and not seenIds[e.id] then
					seenIds[e.id] = true
					table.insert(emotes, e)
					addRow(e)
				end
			end
			currentIndex = endIndex + 1
		end

		if currentIndex > #currentFiltered then noMore = true end
		statusLabel.Text = #emotes .. " / " .. #currentFiltered .. " emotes loaded (" .. activePage .. ")"
		isLoading = false
	end)
end

local function resetAndSearch(kw)
	currentKeyword = kw or ""
	emotes = {}
	seenIds = {}
	rowButtons = {}
	currentIndex = 1
	noMore = false
	stopEmote()
	for _, c in ipairs(listFrame:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	updateFilteredList()
	loadMore()
end

