-- PERSISTENT CONFIG DATA (SAVE / LOAD)
--------------------------------------------------------------------------------
local userConfig = {
	Favourites = {},
	Keybinds = {}
}

local function loadUserConfig()
	if readfile and isfile and isfile(CONFIG_FILE) then
		local ok, result = pcall(function()
			return HttpService:JSONDecode(readfile(CONFIG_FILE))
		end)
		if ok and type(result) == "table" then
			userConfig.Favourites = result.Favourites or {}
			userConfig.Keybinds = result.Keybinds or {}
		end
	end
end

local function saveUserConfig()
	if writefile then
		pcall(function()
			writefile(CONFIG_FILE, HttpService:JSONEncode(userConfig))
		end)
	end
end

