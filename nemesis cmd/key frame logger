	if not autoDetect then return end
	if isRecording then
		-- If animation stopped while auto-recording, stop
		local char = getCharacter()
		local playing = isAnimationPlaying(char)
		if wasPlaying and not playing then
			-- Animation ended
			stopRecording(true)
			recordBtn.Text = "Record"
			recordBtn.BackgroundColor3 = THEME.Accent
			recordBtn.BackgroundTransparency = 0
			recordBtn.TextColor3 = Color3.fromRGB(15, 15, 15)
			refreshList()
		end
		wasPlaying = playing
		return
	end

	local char = getCharacter()
	local playing = isAnimationPlaying(char)
	if playing and not wasPlaying then
		-- Animation just started
		startRecording()
		recordBtn.Text = "Stop"
		recordBtn.BackgroundColor3 = THEME.ButtonIdle
		recordBtn.BackgroundTransparency = 0.15
		recordBtn.TextColor3 = THEME.TextPrimary
	end
	wasPlaying = playing
end)

refreshList()
print("NEMESIS Keyframe Logger loaded")
