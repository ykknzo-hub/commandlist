--------------------------------------------------------------------------------
-- SAVE / LOAD
--------------------------------------------------------------------------------
local function serializeRecordings()
	local out = {}
	for _, rec in ipairs(recordings) do
		local kfs = {}
		for _, kf in ipairs(rec.keyframes) do
			local data = {}
			for partName, cf in pairs(kf.Data) do
				data[partName] = cframeToTable(cf)
			end
			table.insert(kfs, { Time = kf.Time, Data = data })
		end
		table.insert(out, { name = rec.name, keyframes = kfs })
	end
	return out
end

local function deserializeRecordings(raw)
	local out = {}
	if type(raw) ~= "table" then return out end
	for _, rec in ipairs(raw) do
		if type(rec) == "table" and type(rec.name) == "string" and type(rec.keyframes) == "table" then
			local kfs = {}
			for _, kf in ipairs(rec.keyframes) do
				if type(kf) == "table" and type(kf.Data) == "table" then
					local data = {}
					for partName, t in pairs(kf.Data) do
						data[partName] = tableToCFrame(t)
					end
					table.insert(kfs, { Time = tonumber(kf.Time) or 0, Data = data })
				end
			end
			table.insert(out, { name = rec.name, keyframes = kfs })
		end
	end
	return out
end

local function saveConfig()
	if not writefile then return end
	local data = {
		recordings = serializeRecordings(),
		autoDetect = autoDetect,
	}
	local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if ok and encoded then
		pcall(writefile, SAVE_FILE, encoded)
	end
end

local function loadConfig()
	if not (isfile and readfile) then return end
	if not isfile(SAVE_FILE) then return end
	local ok, content = pcall(readfile, SAVE_FILE)
	if not ok or type(content) ~= "string" or content == "" then return end
	local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
	if not ok2 or type(data) ~= "table" then return end
	if data.recordings then
		recordings = deserializeRecordings(data.recordings)
	end
	if data.autoDetect ~= nil then
		autoDetect = data.autoDetect and true or false
	end
end

loadConfig()

--------------------------------------------------------------------------------
-- KEYFRAME CAPTURE
--------------------------------------------------------------------------------
local function getCharacter()
	return LocalPlayer.Character
end

local function getMotors(char)
	local motors = {}
	if not char then return motors end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part1 then
			motors[d.Part1.Name] = d
		end
	end
	return motors
end

local function samplePose(char)
	local data = {}
	local motors = getMotors(char)
	for partName, motor in pairs(motors) do
		-- Record Transform (what animations drive)
		data[partName] = motor.Transform
	end
	-- Also include HumanoidRootPart identity-ish for format compatibility
	if char:FindFirstChild("HumanoidRootPart") then
		data["HumanoidRootPart"] = CFrame.new()
	end
	return data
end

local function isAnimationPlaying(char)
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then return false end
	local tracks = animator:GetPlayingAnimationTracks()
	for _, track in ipairs(tracks) do
		if track.IsPlaying and track.Length > 0.05 then
			-- Ignore default idle-ish short loops if needed; count any real track
			return true, track
		end
	end
	return false
end

local function buildExportString(name, keyframes)
	local lines = {}
	table.insert(lines, "return {")
	table.insert(lines, string.format('\t["%s"] = {', name:gsub('"', '\\"')))
	for _, kf in ipairs(keyframes) do
		table.insert(lines, string.format("\t\t{Time = %.4f, Data = {", kf.Time))
		for partName, cf in pairs(kf.Data) do
			table.insert(lines, string.format('\t\t\t["%s"] = %s,', partName, cframeToString(cf)))
		end
		table.insert(lines, "\t\t}},")
	end
	table.insert(lines, "\t},")
	table.insert(lines, "}")
	return table.concat(lines, "\n")
end

local function stopRecording(saveIt)
	if not isRecording then return end
	isRecording = false
	if recordConnection then
		recordConnection:Disconnect()
		recordConnection = nil
	end

	if saveIt and #currentKeyframes >= 2 then
		local name = "Recording_" .. tostring(#recordings + 1)
		table.insert(recordings, {
			name = name,
			keyframes = currentKeyframes,
		})
		saveConfig()
		statusText = "Saved: " .. name .. " (" .. #currentKeyframes .. " frames)"
	else
		statusText = "Recording discarded (too short)"
	end
	currentKeyframes = {}
end

local function startRecording()
	if isRecording then return end
	local char = getCharacter()
	if not char then
		statusText = "No character"
		return
	end

	isRecording = true
	currentKeyframes = {}
	recordStartTime = tick()
	lastSampleTime = 0
	statusText = "Recording..."

	-- First frame at t=0
	table.insert(currentKeyframes, {
		Time = 0,
		Data = samplePose(char),
	})

	recordConnection = RunService.Heartbeat:Connect(function()
		if not isRecording then return end
		local char = getCharacter()
		if not char then
			stopRecording(true)
			return
		end

		local elapsed = tick() - recordStartTime
		if elapsed - lastSampleTime < SAMPLE_RATE then return end
		lastSampleTime = elapsed

		table.insert(currentKeyframes, {
			Time = math.floor(elapsed * 1000 + 0.5) / 1000,
			Data = samplePose(char),
		})

		statusText = string.format("Recording... %.1fs (%d frames)", elapsed, #currentKeyframes)
	end)
end

