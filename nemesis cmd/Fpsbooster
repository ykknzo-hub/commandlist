--------------------------------------------------------------------------------
-- HELPERS
--------------------------------------------------------------------------------
local function tween(i, p, info)
	local t = TweenService:Create(i, info or TWEEN_INFO, p)
	t:Play()
	return t
end

local function corner(p, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = r or UDim.new(0, 12)
	c.Parent = p
end

local function stroke(p, col, th)
	local s = Instance.new("UIStroke")
	s.Color = col or THEME.Stroke
	s.Thickness = th or 1
	s.Parent = p
	return s
end

local function makeButton(parent, props)
	local btn = Instance.new("TextButton")
	btn.Size = props.Size or UDim2.new(1, 0, 0, 30)
	btn.BackgroundColor3 = props.BackgroundColor3 or THEME.ButtonIdle
	btn.BackgroundTransparency = props.BackgroundTransparency or 0.25
	btn.AutoButtonColor = false
	btn.Text = props.Text or ""
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = props.TextSize or 12
	btn.TextColor3 = props.TextColor3 or THEME.TextPrimary
	btn.Parent = parent
	corner(btn, UDim.new(0, 8))
	local st = stroke(btn)
	st.Transparency = 0.3
	btn.MouseEnter:Connect(function()
		tween(btn, { BackgroundColor3 = THEME.ButtonHover, BackgroundTransparency = 0.1 }, HOVER_TWEEN)
		tween(st, { Color = THEME.Accent, Transparency = 0 }, HOVER_TWEEN)
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, {
			BackgroundColor3 = props.BackgroundColor3 or THEME.ButtonIdle,
			BackgroundTransparency = props.BackgroundTransparency or 0.25
		}, HOVER_TWEEN)
		tween(st, { Color = THEME.Stroke, Transparency = 0.3 }, HOVER_TWEEN)
	end)
	return btn
end

--------------------------------------------------------------------------------
-- APPLY / RESTORE
--------------------------------------------------------------------------------
local function setLowQuality(on)
	if on then
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
	else
		pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
	end
end

local function setNoShadows(on)
	if on then
		Lighting.GlobalShadows = false
	else
		Lighting.GlobalShadows = cache.GlobalShadows
	end
end

local function setNoPostFX(on)
	if on then
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("BlurEffect") or v:IsA("BloomEffect") or v:IsA("SunRaysEffect")
				or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") then
				if cache.PostFX[v] == nil then
					cache.PostFX[v] = v.Enabled
				end
				v.Enabled = false
			end
		end
	else
		for inst, was in pairs(cache.PostFX) do
			if inst and inst.Parent then
				inst.Enabled = was
			end
		end
	end
end

local function setNoParticles(on)
	if on then
		for _, v in ipairs(Workspace:GetDescendants()) do
			if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
				if cache.Particles[v] == nil then
					cache.Particles[v] = v.Enabled
				end
				v.Enabled = false
			end
		end
	else
		for inst, was in pairs(cache.Particles) do
			if inst and inst.Parent then
				inst.Enabled = was
			end
		end
	end
end

local function setNoTextures(on)
	if on then
		for _, v in ipairs(Workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				if cache.Materials[v] == nil then
					cache.Materials[v] = {
						Material = v.Material,
						TextureID = v:IsA("MeshPart") and v.TextureID or nil,
					}
				end
				pcall(function()
					v.Material = Enum.Material.SmoothPlastic
					if v:IsA("MeshPart") then v.TextureID = "" end
				end)
			elseif v:IsA("Decal") or v:IsA("Texture") then
				if cache.Decals[v] == nil then
					cache.Decals[v] = v.Transparency
				end
				v.Transparency = 1
			end
		end
	else
		for part, data in pairs(cache.Materials) do
			if part and part.Parent then
				pcall(function()
					part.Material = data.Material
					if part:IsA("MeshPart") and data.TextureID ~= nil then
						part.TextureID = data.TextureID
					end
				end)
			end
		end
		for decal, trans in pairs(cache.Decals) do
			if decal and decal.Parent then
				decal.Transparency = trans
			end
		end
	end
end

local function setNoTerrainDeco(on)
	pcall(function()
		Workspace.Terrain.Decoration = on and false or cache.TerrainDecoration
	end)
end

local function setFullbright(on)
	if on then
		Lighting.Brightness = 2
		Lighting.ClockTime = 14
		Lighting.FogEnd = 9e9
		Lighting.GlobalShadows = false
		pcall(function() Lighting.Technology = Enum.Technology.Compatibility end)
	else
		Lighting.Brightness = cache.Brightness
		Lighting.ClockTime = cache.ClockTime
		Lighting.FogEnd = cache.FogEnd
		Lighting.GlobalShadows = S.NoShadows and false or cache.GlobalShadows
		pcall(function() Lighting.Technology = cache.Technology end)
	end
end

local function setDisableWater(on)
	pcall(function()
		if on then
			Workspace.Terrain.WaterWaveSize = 0
			Workspace.Terrain.WaterWaveSpeed = 0
			Workspace.Terrain.WaterReflectance = 0
			Workspace.Terrain.WaterTransparency = 0
		else
			Workspace.Terrain.WaterWaveSize = cache.WaterWaveSize
			Workspace.Terrain.WaterWaveSpeed = cache.WaterWaveSpeed
			Workspace.Terrain.WaterReflectance = cache.WaterReflectance
			Workspace.Terrain.WaterTransparency = cache.WaterTransparency
		end
	end)
end

local function setOptimizeMesh(on)
	pcall(function()
		if on then
			settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
		else
			settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.DistanceBased
		end
	end)
end

local function setGCBoost(on)
	if gcThread then
		S.GCBoost = false
		gcThread = nil
	end
	if on then
		S.GCBoost = true
		gcThread = task.spawn(function()
			while S.GCBoost do
				pcall(function() collectgarbage("collect") end)
				task.wait(5)
			end
		end)
	end
end

local function setUnlockFPS(on)
	if on then
		local cap = S.TargetFPS
		if cap and cap > 0 then
			pcall(function() setfpscap(cap) end)
		else
			pcall(function() setfpscap(9999) end)
		end
	else
		pcall(function() setfpscap(60) end)
	end
end

local function setGraphicsQuality(level)
	level = math.clamp(math.floor(level), 1, 10)
	S.GraphicsQuality = level
	pcall(function()
		local enumName = "Level0" .. tostring(level)
		settings().Rendering.QualityLevel = Enum.QualityLevel[enumName] or Enum.QualityLevel.Level01
	end)
end

local function applyKey(key, on)
	S[key] = on
	if key == "LowQuality" then setLowQuality(on)
	elseif key == "NoShadows" then setNoShadows(on)
	elseif key == "NoPostFX" then setNoPostFX(on)
	elseif key == "NoParticles" then setNoParticles(on)
	elseif key == "NoTextures" then setNoTextures(on)
	elseif key == "NoTerrainDeco" then setNoTerrainDeco(on)
	elseif key == "Fullbright" then setFullbright(on)
	elseif key == "DisableWater" then setDisableWater(on)
	elseif key == "OptimizeMesh" then setOptimizeMesh(on)
	elseif key == "GCBoost" then setGCBoost(on)
	elseif key == "UnlockFPS" then setUnlockFPS(on)
	end
end

local function resetAll()
	local keys = {
		"LowQuality", "NoShadows", "NoPostFX", "NoParticles", "NoTextures",
		"NoTerrainDeco", "Fullbright", "DisableWater", "OptimizeMesh", "GCBoost", "UnlockFPS"
	}
	for _, key in ipairs(keys) do
		applyKey(key, false)
		if toggleSetters[key] then
			toggleSetters[key](false)
		end
	end
	S.TargetFPS = 0
	S.GraphicsQuality = 1
	pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end)
	pcall(function() setfpscap(60) end)
end

local function maxBoost()
	local keys = {
		"LowQuality", "NoShadows", "NoPostFX", "NoParticles", "NoTextures",
		"NoTerrainDeco", "Fullbright", "DisableWater", "OptimizeMesh", "GCBoost", "UnlockFPS"
	}
	for _, key in ipairs(keys) do
		applyKey(key, true)
		if toggleSetters[key] then
			toggleSetters[key](true)
		end
	end
end

